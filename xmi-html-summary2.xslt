<?xml version="1.0"?>
<!DOCTYPE xsl:stylesheet [ <!ENTITY nbsp "&#160;"> ]>
<!-- xsl:stylesheet
	xmlns:xsl='http://www.w3.org/1999/XSL/Transform'
	xmlns:UML='href://org.omg/UML/1.1'
	xmlns:CWM="org.omg.CWM1.0/ObjectModel" xmlns:UML="org.omg.CWM1.0/Core" xmlns:CWMRDB="org.omg.CWM1.0/Relational"
	version="1.0" -->
<xsl:stylesheet 
	xmlns:xsl='http://www.w3.org/1999/XSL/Transform'
	xmlns:CWM="org.omg.CWM1.0/ObjectModel" xmlns:UML="org.omg.CWM1.0/Core" xmlns:CWMRDB="org.omg.CWM1.0/Relational"
	version="1.0">
	<xsl:output method="html"  version="4.0" encoding="utf-8" indent="yes"/>
	<xsl:key name="el-index" match="//*" use="@xmi.id"/>
	<!-- xsl:key name="type-index" match="//CWMRDB:SQLSimpleType" use="@xmi.id"/ -->

	<!--
<CWMRDB:ForeignKey xmi.id="FK_DS_SAP__VIOB044" name="ACTA_FK_3" visibility="public" namespace="DS_SAP__VIOB04" uniqueKey="PK_DS_SAP__VIOB03">
	<CWM:KeyRelationship.feature>
		<CWM:StructuralFeature xmi.idref="DS_SAP__VIOB04_BUKRS"/>
		<CWM:StructuralFeature xmi.idref="DS_SAP__VIOB04_SWENR"/>
		<CWM:StructuralFeature xmi.idref="DS_SAP__VIOB04_SGENR"/>
	</CWM:KeyRelationship.feature>
</CWMRDB:ForeignKey>

<CWMRDB:PrimaryKey xmi.id="PK_DS_SAP__VIOB03" name="PK_DS_SAP__VIOB03" visibility="public" namespace="DS_SAP__VIOB03">
	<CWM:UniqueKey.feature>
		<CWM:StructuralFeature xmi.idref="DS_SAP__VIOB03_BUKRS"/>
		<CWM:StructuralFeature xmi.idref="DS_SAP__VIOB03_SWENR"/>
		<CWM:StructuralFeature xmi.idref="DS_SAP__VIOB03_SGENR"/>
	</CWM:UniqueKey.feature>
	<CWM:UniqueKey.keyRelationship>
		<CWM:KeyRelationship xmi.idref="FK_DS_SAP__VIOB044"/>
	</CWM:UniqueKey.keyRelationship>
</CWMRDB:PrimaryKey>

	-->
	<xsl:template match="CWMRDB:ForeignKey">
		<!-- Foreign Key -->
		<xsl:variable name="fk" select="."/>
		<xsl:variable name="table" select="key('el-index',./@namespace)"/>
		<!-- Unique Key -->
		<xsl:variable name="uk" select="key('el-index',./@uniqueKey)" />
		<xsl:variable name="reftable" select="key('el-index',$uk/@namespace)" />
		<xsl:variable name="desc" select="$reftable/UML:ModelElement.taggedValue/UML:TaggedValue[@tag='TechnicalDescription']/@value"/>
		<h4>
			<xsl:value-of select="$table/@name"/><xsl:text disable-output-escaping="yes">&amp;nbsp;&amp;rarr;&amp;nbsp;</xsl:text><xsl:value-of select="$reftable/@name"/><xsl:if test="$desc"> - <xsl:value-of select="$desc"/>&nbsp;</xsl:if>(<xsl:value-of select="$fk/@name"/>)
		</h4>
		<table>
			<tbody>
				<xsl:for-each select="./CWM:KeyRelationship.feature/CWM:StructuralFeature">
					<xsl:variable name="kposition" select="position()" />
					<tr>
						<td>
							<xsl:value-of select="$table/@name"/>.<xsl:value-of select="key('el-index',./@xmi.idref)/@name"/>
						</td>
						<td>
							<xsl:value-of select="$reftable/@name"/>.<xsl:value-of select="key('el-index',$uk/CWM:UniqueKey.feature/CWM:StructuralFeature[$kposition]/@xmi.idref)/@name"/>
						</td>
					</tr>
				</xsl:for-each>
			</tbody>
		</table>
	</xsl:template>

	<!--
		This transform summarizes in HTML an XMI 1.1 generated by Business Objects DS 
		(NB! BO DS generats wrong namespaces) 
	-->
	<xsl:template match="/" >
		<html>
			<head>
				<title></title>
				<xsl:call-template name="css" />
			</head>
			<body>
				
		<h1>
			List (Number of tables: <xsl:value-of select="count(//CWMRDB:Table)"/>)
		</h1>
		<ul>
			<xsl:for-each select="//CWMRDB:Table">
				<xsl:sort select="@name"/>
				<li>
					<a href="#{@name}">
						<xsl:value-of select="@name"/>
					</a>
					<xsl:variable name="desc" select="UML:ModelElement.taggedValue/UML:TaggedValue[@tag='TechnicalDescription']/@value"/>
					<xsl:if test="$desc"> - <xsl:value-of select="$desc"/></xsl:if>
				</li>
			</xsl:for-each>
		</ul>

		<xsl:for-each select="//CWMRDB:Table">
			<xsl:sort select="@name"/>
			<xsl:variable name="table-name" select="@name"/>
			<xsl:variable name="table-id" select="@xmi.id"/>
			<xsl:variable name="desc" select="UML:ModelElement.taggedValue/UML:TaggedValue[@tag='TechnicalDescription']/@value"/>
			<xsl:variable name="pk" select="CWM:Namespace.ownedElement/CWMRDB:PrimaryKey"/>
			<h1>
				<a name="{@name}">
					<xsl:if test="$desc">
							<xsl:value-of select="$desc"/>&nbsp;(<xsl:value-of select="@name"/>)
					</xsl:if>
					<xsl:if test="not($desc)">
							<xsl:value-of select="@name"/>
					</xsl:if>
				</a>
			</h1>
			<h2>Filtering Criteria</h2>
			<p>SAP – N/A</p>
			<h2>Validation</h2>
			<!-- h3>Technical Description</h3 -->
			<!-- h3>Columns</h3 -->
			<table>
				<thead>
					<tr>
						<th>#</th>
						<th>Name</th>
						<th>Type</th>
						<th>&nbsp;</th>
						<th>Column Description</th>
						<th>Verification Criteria</th>
					</tr>
				</thead>
				<tbody>
					<xsl:for-each select="CWM:Classifier.feature/CWMRDB:Column">
						<xsl:variable name="id" select="@xmi.id" />
						<xsl:variable name="name" select="@name" />
						<tr>
							<xsl:if test="(position() mod 2) != 1">
								<xsl:attribute name="class">odd</xsl:attribute>
							</xsl:if>
							<td></td>
							<td>
								<xsl:choose>
									<xsl:when test="$pk/CWM:UniqueKey.feature/CWM:StructuralFeature[@xmi.idref=$id] or $pk/@feature=$id">
										<b>
											<xsl:value-of select="$name"/>
										</b>
									</xsl:when>
									<xsl:otherwise>
										<xsl:value-of select="$name"/>
									</xsl:otherwise>
								</xsl:choose>

							</td>
							<td>
								<i style="font-size:xx-small;">
									<xsl:variable name="mapped-type" select="key('el-index',@type)" />
 									<xsl:choose>
										<xsl:when test="$mapped-type"><xsl:value-of select="$mapped-type/@name"/></xsl:when>
										<xsl:when test="@type='di_char'">varchar</xsl:when>
										<xsl:when test="@type='di_decimal'">numeric</xsl:when>
										<xsl:when test="contains(@type,'di_')">
											<xsl:value-of select="substring(@type, 4)"/>
										</xsl:when>
										<xsl:otherwise>
											<xsl:value-of select="@type"/>
										</xsl:otherwise>
									</xsl:choose>
									<xsl:if test="@length">
										(<xsl:value-of select="@length"/>)
									</xsl:if>
									<xsl:if test="@precision">
										(<xsl:value-of select="@precision"/><xsl:if test="@scale">
											,<xsl:value-of select="@scale"/>
										</xsl:if>)
									</xsl:if>
								</i>
							</td>
							<td>
								<xsl:if test="@isNullable='columnNullable'">N</xsl:if>
							</td>
							<td>
								<xsl:value-of select="UML:ModelElement.taggedValue/UML:TaggedValue[@tag='TechnicalDescription']/@value"/>
							</td>
							<td>
								<xsl:variable
									name="related-tables" 
									select="//CWMRDB:Table[@name!=$table-name and CWM:Classifier.feature/CWMRDB:Column/@name = $name]" />
								<xsl:if test="$related-tables">
									Related tables:&nbsp;
									<xsl:for-each select="$related-tables">
										<xsl:sort select="@name"/>
										<a href="#{@name}"><xsl:value-of select="@name"/></a>
										<xsl:if test="position()!=last()">, </xsl:if>
									</xsl:for-each>
								</xsl:if>								
								<xsl:if test="not($related-tables)">&nbsp;</xsl:if>
							</td>

						</tr>

					</xsl:for-each>
				</tbody>
			</table>

			<xsl:apply-templates select="CWM:Namespace.ownedElement/CWMRDB:ForeignKey" />

		</xsl:for-each>

		<ul>
			<xsl:for-each select="//CWMRDB:Table">
				<xsl:sort select="@name"/>
				<li>
					<xsl:variable
						name="desc" 
						select="UML:ModelElement.taggedValue/UML:TaggedValue[@tag='TechnicalDescription']/@value"/>
					<xsl:if test="$desc"><xsl:value-of select="$desc"/></xsl:if> ( <xsl:value-of select="@name"/>)
				</li>
			</xsl:for-each>
		</ul>
		
		
		<xsl:message>
			Number of tables: <xsl:value-of select="count(//CWMRDB:Table)"/>
		</xsl:message>
		<xsl:message>
			Number of classes : <xsl:value-of select="count(//UML:Class)" />
		</xsl:message>
		<!-- table border="1">
			<xsl:apply-templates/>
		</table -->
			</body>
		</html>
	</xsl:template>


	<!-- This transform summarizes in HTML an XMI 1.1 / UML 1.3 file
(from Unicorn or Rose add-in e.g.) 
-->

<xsl:template match="UML:Class/*/UML:Attribute" >
	<xsl:variable name="class-id" select="../../@xmi.id" />
	<xsl:variable name="attribute-id" select="@xmi.id/text()" />
	<tr><!-- Class -->
		<td><xsl:value-of select="../../@name" /></td>
		<td><xsl:value-of select="
				// UML:TaggedValue [ @tag = 'documentation' ] 
				[ @modelElement = $class-id ]
				/ UML:TaggedValue.value
				" /></td>
		<!-- Attribute -->
		<td><xsl:value-of select="      @name" /></td>
		<td> <xsl:apply-templates mode="documentation" select="$attribute-id" /> </td>
		<td><xsl:value-of select="      key('type', @type)/@name" /></td>
		<td><xsl:value-of select="      @type" /></td>
		</tr><xsl:text>
	</xsl:text>
</xsl:template>

<xsl:key name = "type"
   match = "//UML:DataType"
   use = "@xmi.id" />

<xsl:template mode="documentation" match='text()' >
<xsl:value-of select="
				// UML:TaggedValue [ @tag = 'documentation' ] 
				[ @modelElement = . ]
				/ UML:TaggedValue.value
				" />
</xsl:template>

<!--
<xsl:template match="UML:Class" >
	<tr>
		<td><xsl:value-of select="@name" /></td>
	<xsl:apply-templates mode="fields" />
		</tr><xsl:text>
	</xsl:text>
</xsl:template>

<xsl:template match="UML:Attribute" mode="fields" >
		<td><xsl:value-of select="@name" /></td>
</xsl:template>
-->


